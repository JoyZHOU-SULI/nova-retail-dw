{
	"extend":{
		"mode":"wizard",
		"resourceGroup":"${script.extend.resourceGroup}",
		"cu":0.5,
		"__new__":true,
		"formatType":"filespec"
	},
	"externalCode":{
		"type":"job",
		"version":"2.0",
		"steps":[
			{
				"stepType":"oss",
				"parameter":{
					"compress":"",
					"datasource":"${script.externalCode.steps[0].parameter.datasource}",
					"column":[
						{
							"name":"item_id",
							"index":0,
							"type":"LONG"
						},
						{
							"name":"supplier_id",
							"index":1,
							"type":"LONG"
						},
						{
							"name":"item_name",
							"index":2,
							"type":"STRING"
						},
						{
							"name":"category",
							"index":3,
							"type":"STRING"
						},
						{
							"name":"unit_price",
							"index":4,
							"type":"DOUBLE"
						},
						{
							"name":"cost_price",
							"index":5,
							"type":"DOUBLE"
						},
						{
							"name":"stock_qty",
							"index":6,
							"type":"LONG"
						},
						{
							"name":"replenish_date",
							"index":7,
							"type":"DATE"
						}
					],
					"objectRegex":"nova_erp/02_erp_supplier.csv",
					"skipHeader":"true",
					"successOnNoObject":false,
					"encoding":"UTF-8",
					"fieldDelimiter":",",
					"processMode":"lineByLine",
					"fileFormat":"csv",
					"object":[
						"nova_erp/02_erp_supplier.csv"
					]
				},
				"name":"Reader",
				"category":"reader"
			},
			{
				"stepType":"odps",
				"parameter":{
					"partition":"pt=${bizdate}",
					"isCompress":false,
					"truncate":true,
					"datasource":"${script.externalCode.steps[1].parameter.datasource}",
					"tunnelQuota":"default",
					"column":[
						"item_id",
						"supplier_id",
						"item_name",
						"category",
						"unit_price",
						"cost_price",
						"stock_qty",
						"replenish_date"
					],
					"emptyAsNull":false,
					"table":"ods_supplier",
					"consistencyCommit":false
				},
				"name":"Writer",
				"category":"writer"
			}
		],
		"setting":{
			"errorLimit":{
				"record":"0"
			},
			"locale":"zh_CN",
			"speed":{
				"throttle":false,
				"concurrent":2
			}
		}
	},
	"migrationType":"SingleTableOffline",
	"jobType":"SingleTableOfflineMigration"
}